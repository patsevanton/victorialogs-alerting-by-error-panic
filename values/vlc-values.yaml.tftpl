# vlagent (DaemonSet) собирает логи всех подов и шлёт в VictoriaLogs.
# Генерируется Terraform'ом из values/vlc-values.yaml.tftpl через templatefile()
# (monitoring.tf). Параметры приходят из local.*.
nameOverride: ${vlc_name_override}

remoteWrite:
  - url: ${vls_server_url}

collector:
  # Не собираем логи самого коллектора (иначе будет шум).
  # `HOSTNAME` — плейсхолдер самого vlagent, экранирован от Terraform-шаблона.
  excludeFilter: "kubernetes.pod_name:=%%{HOSTNAME}"
