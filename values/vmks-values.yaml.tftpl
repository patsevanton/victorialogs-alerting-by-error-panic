# Values для встроенного vmalert из victoria-metrics-k8s-stack.
# Правила читаются из файла (ConfigMap `vmalert-rules`), datasource — VictoriaLogs.
#
# vmalert пишет состояние алертов (ALERTS, ALERTS_FOR_STATE) в VictoriaMetrics:
# VictoriaLogs сам метрики не хранит, поэтому remoteWrite/remoteRead остаются
# указывать на vmsingle из этого же стека — vmalert обязан куда-то писать
# состояние и восстанавливать его при рестарте.

grafana:
  # Отключаем управление алертами через Grafana UI (Grafana Alerting).
  # Алерты управляются только файлом правил и vmalert.
  grafana.ini:
    alerting:
      enabled: false
    unified_alerting:
      enabled: false
  plugins:
    # Плагин datasource VictoriaLogs (Grafana скачает его из интернета,
    # в кластере есть исходящий доступ через NAT-шлюз).
    - victoriametrics-logs-datasource
  ingress:
    enabled: true
    ingressClassName: traefik
    hosts:
      - grafana.${ingress_public_ip}.sslip.io

defaultDatasources:
  victoriametrics:
    datasources:
      - name: VictoriaMetrics
        type: prometheus
        access: proxy
        isDefault: true
        uid: VictoriaMetrics
  # VictoriaLogs развёрнут отдельным чартом victoria-logs-single, поэтому
  # добавляем datasource вручную с явным URL (не через встроенный vlsingle CRD).
  extra:
    - name: VictoriaLogs
      access: proxy
      isDefault: false
      uid: VictoriaLogs
      type: victoriametrics-logs-datasource
      url: http://vls-server.vmks.svc.cluster.local:9428

# Отключаем контроль control-plane: Yandex Managed K8s master вне кластера.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false
defaultRules:
  groups:
    etcd:
      enabled: false
    kubernetes-system-scheduler:
      enabled: false
    kubernetes-system-controller-manager:
      enabled: false
    kube-scheduler.rules:
      enabled: false

vmsingle:
  enabled: true
  spec:
    # VictoriaLogs сам метрики не хранит, поэтому vmalert пишет состояние
    # алертов сюда. Достаточно single-node.
    retentionPeriod: "14d"
    storage:
      resources:
        requests:
          storage: 20Gi

vmcluster:
  enabled: false

# vmalert исполняет правила из файла (ConfigMap vmalert-rules), datasource = VictoriaLogs.
vmalert:
  enabled: true
  spec:
    selectAllByDefault: false
    evaluationInterval: 1m
    # datasource = VictoriaLogs (read endpoint). Запросы LogsQL уходят на :9428.
    datasource:
      url: "http://vls-server.vmks.svc.cluster.local:9428"
    # Монтируем ConfigMap vmalert-rules в /etc/vm/configs/vmalert-rules.
    configMaps:
      - vmalert-rules
    extraArgs:
      rule: "/etc/vm/configs/vmalert-rules/*.yaml"
      rule.defaultRuleType: "vlogs"

alertmanager:
  enabled: true
  spec:
    # Secret telegram-bot-token монтируется оператором в
    # /etc/vm/secrets/telegram-bot-token/bot-token.
    secrets:
      - telegram-bot-token
  ingress:
    enabled: true
    ingressClassName: traefik
    hosts:
      - alertmanager.${ingress_public_ip}.sslip.io
  config:
    global:
      resolve_timeout: 5m
    route:
      receiver: telegram
      group_by: ["alertname", "app"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
    receivers:
      - name: telegram
        telegram_configs:
          - bot_token_file: /etc/vm/secrets/telegram-bot-token/bot-token
            chat_id: ${telegram_chat_id}
            parse_mode: HTML
            send_resolved: true
            message: |-
              {{- range .Alerts }}
              <b>{{ .Status | toUpper }}</b> <code>{{ .Labels.alertname }}</code>
              app: <code>{{ .Labels.app }}</code>
              {{- if .Annotations.summary }}
              {{ .Annotations.summary }}
              {{- end }}
              {{- if .Annotations.description }}
              {{ .Annotations.description }}
              {{- end }}
              {{ end }}
